# Local-only example values. Never commit your actual .env.
DATABASE_URL=postgresql+psycopg://postgres:proofstack-local@127.0.0.1:55432/proofstack
SIGNALLOOP_ENV=local
PUBLIC_BASE_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
EXECUTION_BACKEND=http_worker
EXECUTION_WORKER_URL=http://127.0.0.1:9001
ASSESSMENT_RUNTIME_IMAGE=signalloop-python-assessment:3.11
REPORT_ADVISORY_ENABLED=false
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_CLASSIFIER_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_GENERATION_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
PROOFSTACK_DAILY_AI_CALLS=120
PROOFSTACK_DAILY_AI_ALLOWANCE=400000
